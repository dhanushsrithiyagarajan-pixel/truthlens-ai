# TruthLens AI Environment Configuration
# Copy this file to .env and configure your values.
# The application functions in full OFFLINE DEMO MODE if no API key is provided.

FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=truthlens-dev-secret-key-change-in-production-2026
PORT=5000

# Optional: Google Gemini API Key for online LLM verification
# If left empty, TruthLens AI automatically uses the intelligent heuristic rule engine.
GEMINI_API_KEY=
